+package br.com.danilo.feedlauncher.classic;
+
+import android.graphics.Rect;
+
+/**
+ * Dependency-free adaptation of Launcher3 util/GridOccupancy for Classic mode.
+ *
+ * The public behaviour intentionally follows AOSP Launcher3: X-major boolean grid,
+ * first-vacant search, region vacancy checks, cell marking, copying and clearing.
+ */
+final class L3GridOccupancy {
+    private final int countX;
+    private final int countY;
+    final boolean[][] cells;
+
+    L3GridOccupancy(int countX,int countY){
+        this.countX=Math.max(1,countX);
+        this.countY=Math.max(1,countY);
+        cells=new boolean[this.countX][this.countY];
+    }
+
+    boolean findVacantCell(int[] out,int spanX,int spanY){
+        if(out==null||out.length<2)return false;
+        for(int y=0;y+spanY<=countY;y++){
+            for(int x=0;x+spanX<=countX;x++){
+                if(isRegionVacant(x,y,spanX,spanY)){
+                    out[0]=x;out[1]=y;return true;
+                }
+            }
+        }
+        out[0]=out[1]=-1;return false;
+    }
+
+    void copyTo(L3GridOccupancy dest){
+        if(dest==null||dest.countX!=countX||dest.countY!=countY)throw new IllegalArgumentException("Grid size mismatch");
+        for(int x=0;x<countX;x++)System.arraycopy(cells[x],0,dest.cells[x],0,countY);
+    }
+
+    L3GridOccupancy copy(){
+        L3GridOccupancy dest=new L3GridOccupancy(countX,countY);copyTo(dest);return dest;
+    }
+
+    boolean isRegionVacant(int x,int y,int spanX,int spanY){
+        int x2=x+spanX-1,y2=y+spanY-1;
+        if(x<0||y<0||spanX<1||spanY<1||x2>=countX||y2>=countY)return false;
+        for(int i=x;i<=x2;i++)for(int j=y;j<=y2;j++)if(cells[i][j])return false;
+        return true;
+    }
+
+    void markCells(int cellX,int cellY,int spanX,int spanY,boolean value){
+        if(cellX<0||cellY<0||spanX<1||spanY<1)return;
+        for(int x=cellX;x<cellX+spanX&&x<countX;x++){
+            for(int y=cellY;y<cellY+spanY&&y<countY;y++)cells[x][y]=value;
+        }
+    }
+
+    void markCells(Rect r,boolean value){
+        if(r!=null)markCells(r.left,r.top,r.width(),r.height(),value);
+    }
+
+    void clear(){markCells(0,0,countX,countY,false);}
+}
